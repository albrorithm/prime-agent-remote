// Type-checks the server tests, which tsconfig.server.json must exclude because
// it emits the build. Nothing checked them for the life of the project: a test
// helper silently dropped a required config field and the suite spent a while
// writing to the operator's real push-subscription store.
{
  "extends": "./tsconfig.server.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "rootDir": "."
  },
  "include": ["src/protocol.ts", "src/server/**/*.ts", "scripts/**/*.mjs"],
  "exclude": []
}
