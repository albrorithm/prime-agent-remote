# Optional. Leave unset and the gateway mints a 32-byte token itself on first
# run, persisted at mode 0600 — stronger than anything typed here. Set this
# only to override that, with a long random value, and enter it once on the
# pairing screen. Production rejects a configured value shorter than 32 chars.
PRIME_WEB_PAIRING_TOKEN=

# Comma-separated exact browser origins. Required in production.
# Example: https://prime-agent.example-tailnet.ts.net
PRIME_WEB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8787

# Keep loopback when using `tailscale serve`.
PRIME_WEB_HOST=127.0.0.1
PRIME_WEB_PORT=8787

# `demo` is functional without a Prime Agent daemon. `prime` will use the daemon adapter.
PRIME_WEB_BACKEND=demo

# Set to true behind HTTPS in production. Development HTTP defaults to false.
PRIME_WEB_SECURE_COOKIE=false

# Web push and the app-icon badge. Generate a pair with:
#   node scripts/generate-vapid.mjs mailto:you@example.com
# Leave these unset to run without push; nothing else changes.
PRIME_WEB_VAPID_PUBLIC_KEY=
PRIME_WEB_VAPID_PRIVATE_KEY=
PRIME_WEB_VAPID_SUBJECT=

# Where push subscriptions are stored. Defaults under $XDG_CONFIG_HOME
# (or ~/.config) — set an absolute path to move it.
# PRIME_WEB_PUSH_STORE=
